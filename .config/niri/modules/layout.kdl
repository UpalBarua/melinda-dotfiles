layout {
    background-color "transparent"

    gaps 5
    center-focused-column "never"
    always-center-single-column
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
      off
    }

    border {
        on
        width 1.5 
        active-color "#565f89"
        inactive-color "#292e42"
        urgent-color "#7aa2f7"
    }

    shadow {
      off
    }
}
