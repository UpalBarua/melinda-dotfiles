layout {
    background-color "transparent"

    gaps 5
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
      off
    }

    border {
        on
        width 1
        active-color "#c0caf5"
        inactive-color "#283457"
        urgent-color "#524f67"
    }

    shadow {
      off
    }
}
