#!/usr/bin/env bash

# img2webp.sh
# Convert one or more images to optimized WebP.

# --- Configuration ---
QUALITY=80
MAX_SIZE="1600x1600>"
WEBP_METHOD=6

# --- Functions ---

check_dependencies() {
    if ! command -v magick >/dev/null 2>&1; then
        echo "Error: ImageMagick ('magick') not found."
        exit 1
    fi
}

usage() {
    echo "Usage:"
    echo "  $0 <image1> [image2 image3 ...]"
    echo
    echo "Examples:"
    echo "  $0 photo.jpg"
    echo "  $0 photo.jpg logo.png"
    echo "  $0 *.jpg *.png"
}

convert_image() {
    local INPUT_FILE="$1"

    if [ ! -f "$INPUT_FILE" ]; then
        echo "⚠️  Skipping '$INPUT_FILE' (not found)"
        return
    fi

    local OUTPUT_FILE="${INPUT_FILE%.*}.webp"

    echo "Converting:"
    echo "  $INPUT_FILE -> $OUTPUT_FILE"

    if magick "$INPUT_FILE" \
        -resize "$MAX_SIZE" \
        -strip \
        -quality "$QUALITY" \
        -define webp:method="$WEBP_METHOD" \
        "$OUTPUT_FILE"
    then
        ORIGINAL_SIZE=$(du -h "$INPUT_FILE" | awk '{print $1}')
        NEW_SIZE=$(du -h "$OUTPUT_FILE" | awk '{print $1}')

        echo "  ✓ $ORIGINAL_SIZE → $NEW_SIZE"
    else
        echo "  ✗ Failed"
    fi

    echo
}

# --- Main ---

check_dependencies

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

for file in "$@"; do
    convert_image "$file"
done
